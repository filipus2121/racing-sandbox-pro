{
  "name": "racing-sandbox-pro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "2D top-down racing simulator with a full rigid-body Pacejka vehicle model and physics-based AI opponents.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
